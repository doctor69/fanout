# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Google OAuth client id for an INSTALLED APP (iOS / Android) client, created in
# Google Cloud Console with the YouTube Data API v3 enabled. This client type has
# no client secret, which is why YouTube needs no server hop (specs/03).
# The client's redirect URI must be the app's scheme, e.g. fanout:/oauth/youtube
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# X (Twitter) OAuth 2.0 client id from an app in the X developer portal, set up
# as a Native App / public client (PKCE, no secret). Its callback URI must be
# fanout:/oauth/x, and the app needs read + write + media.write permissions.
EXPO_PUBLIC_X_CLIENT_ID=

# Later phases (specs/06-build-plan.md):
# EXPO_PUBLIC_TIKTOK_CLIENT_KEY=
# EXPO_PUBLIC_TOKEN_EXCHANGE_URL=
