# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Google OAuth client id for an INSTALLED APP (iOS / Android) client, created in
# Google Cloud Console with the YouTube Data API v3 enabled. This client type has
# no client secret, which is why YouTube needs no server hop (specs/03).
# The client's redirect URI must be the app's scheme, e.g. fanout:/oauth/youtube
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# X (Twitter) OAuth 2.0 client id from an app in the X developer portal, set up
# as a Native App / public client (PKCE, no secret). Its callback URI must be
# fanout:/oauth/x, and the app needs read + write + media.write permissions.
EXPO_PUBLIC_X_CLIENT_ID=

# TikTok client KEY (TikTok's name for the public client id) from the TikTok
# developer portal. Its redirect URI must be fanout:/oauth/tiktok, and the app
# needs the Login Kit and Content Posting API products with the video.publish
# scope. TikTok's client SECRET does NOT go here — it lives only on the
# token-exchange function, because TikTok requires it even for PKCE clients.
EXPO_PUBLIC_TIKTOK_CLIENT_KEY=

# Meta app id (one app serves both Facebook and Instagram). The app secret does
# NOT go here — it lives only on the token-exchange function.
#
# Needs: a Facebook Page, and for Instagram a Business/Creator account linked to
# that Page. Add fanout:/oauth/facebook and fanout:/oauth/instagram to the app's
# Valid OAuth Redirect URIs.
#
# HEADS UP for the manual pass: Meta has historically wanted https redirect URIs
# for the web OAuth dialog. If it refuses the custom scheme, the fix is a bridge
# route on the token-exchange Worker that 302s back to fanout:/oauth/<platform>.
EXPO_PUBLIC_META_APP_ID=

# LinkedIn app client id. The client secret does NOT go here — it lives only on
# the token-exchange function. The app needs the "Share on LinkedIn" and
# "Sign In with LinkedIn using OpenID Connect" products, and
# fanout:/oauth/linkedin as an authorized redirect URL.
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=

# Base URL of your deployed /functions/token-exchange Worker, e.g.
# https://fanout-token-exchange.<your-subdomain>.workers.dev
EXPO_PUBLIC_TOKEN_EXCHANGE_URL=
